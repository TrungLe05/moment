# Mẫu biến môi trường cho frontend. Sao chép thành .env.local (không commit).
# Biến NEXT_PUBLIC_* được nhúng vào bản build tĩnh, nên tuyệt đối không đặt secret ở đây.

# Địa chỉ backend; đổi nếu backend chạy cổng khác (ví dụ SERVER_PORT=8081).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Client id OAuth của Google, trùng GOOGLE_CLIENT_ID của backend; để trống thì ẩn nút Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
