# Mẫu biến môi trường cho môi trường dev.
# Cách dùng: sao chép thành .env (đã có trong .gitignore) rồi đổi mật khẩu.
# Docker Compose và backend (khi chạy từ IDE hoặc ./mvnw) đều đọc file .env ở gốc repo.
# Viết dạng KEY=value, không dùng dấu nháy: backend đọc file này như file .properties.

# --- PostgreSQL (service postgres) ---
POSTGRES_DB=moment
POSTGRES_USER=moment
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_PORT=5432

# --- Object storage RustFS, chuẩn S3 (service rustfs) ---
S3_ACCESS_KEY=moment-dev
S3_SECRET_KEY=doi-khoa-bi-mat-nay
S3_BUCKET=moment
S3_REGION=us-east-1
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Địa chỉ S3 mà backend và trình duyệt cùng gọi được; production đặt endpoint của Cloudflare R2.
# S3_ENDPOINT=http://localhost:9000

# --- Email dev Mailpit (service mailpit) ---
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Backend ---
# Khóa ký access token, base64, tối thiểu 32 byte. Tạo bằng: openssl rand -base64 48
JWT_SIGNING_KEY=
# Client id OAuth của Google (Google Cloud Console); để trống thì tắt đăng nhập Google.
GOOGLE_CLIENT_ID=
# Gốc URL frontend, dùng để dựng link trong email xác thực, đặt lại mật khẩu.
FRONTEND_BASE_URL=http://localhost:3000
# SMTP: khi dev trỏ vào Mailpit; production đổi sang dịch vụ email thật (Q-011).
MAIL_HOST=localhost
MAIL_FROM=no-reply@moment.local
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Origin của frontend được gọi API, cách nhau bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Khi dev, backend tự dựng kết nối từ các biến POSTGRES_* ở trên.
# Chỉ đặt các biến dưới đây khi database nằm chỗ khác (container, production).
# DB_URL=jdbc:postgresql://localhost:5432/moment
# DB_USERNAME=moment
# DB_PASSWORD=

# Worker xử lý media (profile worker, ADR 0003) cần ffmpeg và ffprobe; mặc định tìm trong PATH (D-034).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Cổng HTTP của worker (chỉ cho health check), khác cổng API khi chạy cả hai trên một máy.
# WORKER_PORT=8090
